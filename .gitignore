# Binaries (keep scripts, ignore compiled binaries)
bin/*.exe
bin/*.dll
bin/*.dylib
bin/*.so
*.exe
*.dll
*.dylib
*.so

# Rust
core/target/
# core/Cargo.lock - removed from gitignore for reproducible builds

# Node
cli/node_modules/
cli/package-lock.json
cli/yarn.lock
cli/.yarn/cache

# Logs
*.log
raw_logs.json
*.log.*

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Build artifacts
dist/
build/
*.tar.gz
*.zip

# Test coverage
coverage/
.nyc_output/

# Temporary files
.tmp/
tmp/
temp/

# Package locks (keep package-lock.json in root)
**/package-lock.json
